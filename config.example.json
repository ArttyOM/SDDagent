{
  "host": "127.0.0.1",
  "port": 5178,
  "outputDirectory": "analytics-output",
  "maxRequestBytes": 104857600,
  "maxInlineFileBytes": 262144,
  "sdd": {
    "defaultProfile": "openspec",
    "profiles": [
      "markdown",
      "openspec",
      "speckit",
      "hybrid"
    ],
    "criticIterations": 1
  },
  "cli": {
    "active": "codex",
    "commands": {
      "codex": {
        "command": "codex",
        "args": [
          "exec",
          "--skip-git-repo-check",
          "--color",
          "never",
          "-s",
          "workspace-write",
          "-"
        ],
        "promptMode": "stdin",
        "closeStdinAfterPrompt": true,
        "cwd": "."
      },
      "gigacode": {
        "command": "gigacode",
        "args": [],
        "promptMode": "stdin",
        "closeStdinAfterPrompt": true,
        "cwd": "."
      }
    }
  },
  "integrations": {
    "jira": {
      "baseUrl": "https://jira.example.local",
      "restApiVersion": "2",
      "authCheckPath": "/rest/api/2/myself",
      "issueFields": [
        "summary",
        "description",
        "status",
        "priority",
        "issuetype",
        "labels",
        "components"
      ],
      "certificate": {
        "pfxPath": "",
        "certPath": "",
        "keyPath": "",
        "caPath": "",
        "passphraseEnv": "JIRA_CERT_PASSPHRASE",
        "rejectUnauthorized": true
      }
    },
    "confluence": {
      "baseUrl": "https://confluence.example.local",
      "restBasePath": "/rest/api",
      "authCheckPath": "/rest/api/user/current",
      "certificate": {
        "pfxPath": "",
        "certPath": "",
        "keyPath": "",
        "caPath": "",
        "passphraseEnv": "CONFLUENCE_CERT_PASSPHRASE",
        "rejectUnauthorized": true
      }
    }
  }
}
